# Local disposable database only. Never use these values in shared or production environments.
DATABASE_URL="postgresql://nova_security_local:nova_security_local@localhost:54329/nova_security_local?schema=public"
PORT=3001
# Generate a unique secret with at least 32 random characters for each environment.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Required opt-in for destructive integration tests against the local disposable database only.
NOVA_ALLOW_DESTRUCTIVE_TEST_DATABASE=true
