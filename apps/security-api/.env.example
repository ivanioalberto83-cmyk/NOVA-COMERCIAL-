# Local disposable database only. Never use these values in shared or production environments.
DATABASE_URL="postgresql://nova_security_local:nova_security_local@localhost:54329/nova_security_local?schema=nova_core"
PORT=3001

# Supabase Auth — use the project URL and publishable/anon key.
# Never place the service_role key or JWT signing secret in this file.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="replace-with-the-project-publishable-or-anon-key"

# Required opt-in for destructive integration tests against the local disposable database only.
NOVA_ALLOW_DESTRUCTIVE_TEST_DATABASE=true
