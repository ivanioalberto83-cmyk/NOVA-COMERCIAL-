{
  "name": "@nova/security-api",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA SECURITY CORE API foundation",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "tsx --test src/security/*.spec.ts",
    "test:e2e": "tsx --test test/health.e2e-spec.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:integration": "tsx --test test/identity.persistence.spec.ts",
    "test:auth": "tsx --test test/password.service.spec.ts test/auth-token.service.spec.ts",
    "test:auth:integration": "tsx --test test/auth.integration.spec.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "prisma": "6.19.0"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "file-type": "^21.3.2",
    "multer": "^2.5.0",
    "qs": "^6.16.1",
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0"
  }
}
