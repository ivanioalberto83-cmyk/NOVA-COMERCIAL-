    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "file-type": "^21.3.2",
    "multer": "^2.5.0",
    "qs": "^6.16.1"
  }
