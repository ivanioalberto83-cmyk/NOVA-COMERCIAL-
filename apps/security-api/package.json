{
  "name": "@nova/security-api",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA SECURITY CORE API foundation",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
